Set Shell "zsh"
Set Theme "Dracula"
Set WindowBar Colorful
Set BorderRadius 10
Set Padding 20
Set FontFamily "JetBrains Mono, Symbols Nerd Font Mono"
Set FontSize 18
Set Width 1200
Set Height 360
Set TypingSpeed 60ms
Set Framerate 24
Env PATH "/demo/stubs:/home/dev/.local/bin:/usr/local/bin:/usr/bin:/bin"
Output "/out/demo-commands.gif"

Hide
Type "exec zsh"
Enter
Sleep 1.5s
Type "clear"
Enter
Type "cd ~/code/shop"
Enter
Sleep 3s
Type "clear"
Enter
Show
Type "sleep 4"
Enter
Sleep 5s
Type "false"
Enter
Sleep 2s
Type "true"
Enter
Sleep 2s
