# <config repo>/zsh/zshrc, loaded by the shellkit block that zsh/install.sh puts at the top of
# ~/.zshrc. The rest of ~/.zshrc is yours and never versioned.
#
# Everything for this machine only lives in $SHELL_LOCAL_DIR (~/.config/shkit,
# chmod 700), never in this repo: settings.sh and secrets.sh (chmod 600), plain
# `export` lines shared with bash; theme.zsh and prompt.d/ (the prompt), zsh only.

_zshrc_dir=${${(%):-%x}:A:h}
SHELL_LOCAL_DIR=${SHELL_LOCAL_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/shkit}   # set: zsh/try.sh
[[ -d ${SHELL_LOCAL_DIR%/*}/shell && ! -e $SHELL_LOCAL_DIR ]] &&   # renamed with shellkit
  echo "shellkit: ~/.config/shell not migrated, run shell/install-local.sh" >&2

# --- Options ------------------------------------------------------------------
setopt AUTO_CD            # `www` = `cd www`
setopt NO_CLOBBER         # `>` never overwrites a file; `>|` does it on purpose
setopt INTERACTIVE_COMMENTS
# `**` recurses by default (bash's globstar). Typos in paths are fixed on <Tab>
# by the _approximate completer below (bash's cdspell/dirspell).

# --- History: one unlimited history, appended as you go (as in bash) ---------
HISTFILE=~/.zsh_history
HISTSIZE=10000000
SAVEHIST=10000000
HISTORY_IGNORE='(exit|ls|bg|fg|history|clear)'
setopt EXTENDED_HISTORY INC_APPEND_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE \
  HIST_REDUCE_BLANKS HIST_VERIFY
# ↑/↓ search the history for what is already typed.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey -e
for _k in '^[[A' '^[OA'; do bindkey "$_k" up-line-or-beginning-search; done
for _k in '^[[B' '^[OB'; do bindkey "$_k" down-line-or-beginning-search; done
unset _k

# --- Esc Esc: toggle `sudo ` in front of the line (empty line: last command) --
function _zshrc_sudo {
  [[ -z $BUFFER ]] && BUFFER=$(fc -ln -1) CURSOR=${#BUFFER}
  if [[ $BUFFER == 'sudo '* ]]; then
    BUFFER=${BUFFER#sudo } CURSOR=$(( CURSOR < 5 ? 0 : CURSOR - 5 ))
  else
    BUFFER="sudo $BUFFER" CURSOR=$(( CURSOR + 5 ))
  fi
}
zle -N _zshrc_sudo
bindkey '^[^[' _zshrc_sudo

# --- A directory's last segment alone = cd to it (`shop` -> cd ~/code/shop) -------
# Among the directories visited (cdr's list, most recent first) when the word is
# no command and no local directory (AUTO_CD covers those). The line becomes the
# `cd`, so the history keeps the real path.
autoload -Uz add-zsh-hook chpwd_recent_dirs chpwd_recent_filehandler
add-zsh-hook chpwd chpwd_recent_dirs
zstyle ':chpwd:*' recent-dirs-file ${XDG_CACHE_HOME:-$HOME/.cache}/zsh/recent-dirs
zstyle ':chpwd:*' recent-dirs-max 500
function _zshrc_jump_target { # WORD -> REPLY: the most recent visited dir named WORD
  REPLY=
  # whence: alias, function, builtin, keyword or $PATH binary (even one installed since) wins
  [[ -n $1 && $1 != *[[:space:]/~\$]* && ! -d $1 ]] && ! whence -- $1 >/dev/null || return 1
  local d; local -a reply
  chpwd_recent_filehandler
  for d in $reply; do [[ ${d:t} == $1 && -d $d ]] && { REPLY=$d; return 0; }; done
  return 1
}
function _zshrc_jump { # spaces around the word allowed: <Tab> leaves one after it
  local -a w=(${=BUFFER})
  (( $#w == 1 )) && _zshrc_jump_target $w && BUFFER="cd ${(q-)REPLY}"
  zle .accept-line
}
zle -N accept-line _zshrc_jump

# --- A one-word line shows what <Enter> will do with it, after the cursor --------
# `(b)` a command (binary, alias, function, builtin), `(d)` a directory cd'ed to
# (a path, or a name <Enter> jumps to), `(f)` a file. Display only: never part of the line.
# The menu of several <Tab> matches redraws without this hook and loses colors past the
# line's end (zsh 5.9), so the hint waits for the choice ($_zshrc_tab_n: _zshrc_command).
function _zshrc_kind_clear {   # zle moves highlights as the line changes: match by shape
  region_highlight=(${region_highlight:#<-> <-> fg=(green|blue|yellow)}); POSTDISPLAY=
}
function _zshrc_kind {
  _zshrc_kind_clear
  [[ $KEYS == $'\t' ]] && (( _zshrc_tab_n > 1 )) && return 0
  local -a w=(${=BUFFER}); local k c   # one word, spaces around allowed (Tab adds one)
  (( $#w == 1 )) || return 0
  local f=${(Q)w/#\~/$HOME}   # the word as a path: unquoted, ~ expanded (no glob)
  if whence -- $w >/dev/null; then k=b c=green
  elif [[ -d $f ]] || _zshrc_jump_target $w; then k=d c=blue
  elif [[ -f $f ]]; then k=f c=yellow
  else return 0; fi
  POSTDISPLAY="   ($k)"
  region_highlight+=("$#BUFFER $(( $#BUFFER + $#POSTDISPLAY )) fg=$c")
}
autoload -Uz add-zle-hook-widget
add-zle-hook-widget line-pre-redraw _zshrc_kind
add-zle-hook-widget line-finish _zshrc_kind_clear   # the line run keeps no hint

# --- Colored man pages --------------------------------------------------------
function man {
  LESS_TERMCAP_mb=$'\e[31m' LESS_TERMCAP_md=$'\e[1;31m' LESS_TERMCAP_me=$'\e[0m' \
  LESS_TERMCAP_so=$'\e[1;33m' LESS_TERMCAP_se=$'\e[0m' \
  LESS_TERMCAP_us=$'\e[32m' LESS_TERMCAP_ue=$'\e[0m' \
  GROFF_NO_SGR=1 command man "$@"
}

# --- Environment --------------------------------------------------------------
typeset -U path fpath   # no duplicate entries
# Homebrew on Apple silicon (/opt/homebrew; Intel's /usr/local is already in PATH and
# fpath): what `brew shellenv` does, without its fork at every start.
[[ -x /opt/homebrew/bin/brew ]] &&
  path=(/opt/homebrew/bin /opt/homebrew/sbin $path) fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
path=(~/.local/bin $path)
[[ -r ~/.cargo/env ]] && . ~/.cargo/env

# --- Completion ---------------------------------------------------------------
# install.sh generates _codex, _symfony… in ~/.local/share/zsh/site-functions.
fpath=(~/.local/share/zsh/site-functions $fpath)
autoload -Uz compinit bashcompinit
mkdir -p ${XDG_CACHE_HOME:-$HOME/.cache}/zsh
compinit -d ${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump
bashcompinit   # for tools that only ship a bash completion
zstyle ':completion:*' menu select
zstyle ':completion:*' completer _complete _approximate
zstyle ':completion:*:approximate:*' max-errors 1 numeric
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
command -v aws_completer >/dev/null && complete -C aws_completer aws
[[ -r ~/.local/share/bash-completion/completions/composer ]] &&
  . ~/.local/share/bash-completion/completions/composer
[[ -r ~/.local/share/zsh/npm-completion.zsh ]] && . ~/.local/share/zsh/npm-completion.zsh

# `git task <prefix>`: local branches whose last segment starts with <prefix>
# (feature/SHOP-42_x matches SHOP-42), case-insensitive.
zstyle ':completion:*:*:git:*' user-commands task:'switch to the branch of a ticket'
function _git-task {
  (( CURRENT == 2 )) || return 1
  local q=${(L)PREFIX} b
  local -a m
  for b in ${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"}; do
    [[ ${(L)b:t} == $q* || ${(L)b} == $q* ]] && m+=$b
  done
  compadd -U -Q -- $m
}

# <Tab> on the first word: commands and local directories (zsh's _autocd), plus the
# visited directories whose name starts with the word (case-insensitive): the word
# becomes the full path (AUTO_CD then cds to it), so you see where it leads.
function _zshrc_command {
  _autocd; local ret=$? expl d
  local -a reply paths; chpwd_recent_filehandler
  for d in ${^reply}(N/); do   # still there
    [[ ${(L)d:t} == ${(L)PREFIX}* ]] || continue
    [[ $d == $HOME/* ]] && paths+="~/${(q-)d#$HOME/}" || paths+=${(q-)d}
  done
  (( $#paths )) && _wanted recent-dirs expl 'visited directory' compadd -U -Q -- $paths && ret=0
  # several: straight into the menu, not their common prefix (a path no one asked for)
  (( $#paths && compstate[nmatches] > 1 )) && compstate[insert]=menu
  _zshrc_tab_n=$compstate[nmatches]   # see _zshrc_kind
  return ret
}
compdef _zshrc_command -command-

function _shkit_p {
  (( CURRENT == 2 )) || return 1
  local -a projects
  projects=("${(@f)$(_shkit_project_completions "$PREFIX")}")
  compadd -U -- "${projects[@]}"
}
compdef _shkit_p p

# --- This machine only (never committed); before the prompt, whose toggles
#     (SHKIT_SHOW_MR=false…) it may set.
[[ -r $SHELL_LOCAL_DIR/settings.sh ]] && . $SHELL_LOCAL_DIR/settings.sh
for _f in $SHELL_LOCAL_DIR/rc.d/*.(sh|zsh)(N); do . $_f; done; unset _f   # drop-ins, e.g. from a dotfiles repo
# theme.zsh, projects/ and plugins/ are read by prompt.zsh, in layers.

# --- Aliases, prompt ----------------------------------------------------------
. "$_zshrc_dir/../shell/aliases.sh"
[[ -r $SHELL_LOCAL_DIR/aliases.sh ]] && . $SHELL_LOCAL_DIR/aliases.sh   # this machine's own
. "$_zshrc_dir/prompt.zsh"

[[ -r $SHELL_LOCAL_DIR/secrets.sh ]] && . $SHELL_LOCAL_DIR/secrets.sh   # never committed, chmod 600
unset _zshrc_dir
