#!/bin/sh
[ "$#" -lt "1" ] && {
  echo "Configure current shell to use a specific PHP version.

    Usage: usephp 8.2"
  exit 0
}

pick() { for w; do [ -x "$w" ] && { echo "$w"; return 0; }; done; return 1; }

# Debian (php8.2), Homebrew on Apple silicon / Intel (php@8.2)
wanted=$(pick "/usr/bin/php${1}" "/opt/homebrew/opt/php@${1}/bin/php" "/usr/local/opt/php@${1}/bin/php") || {
  echo "'php${1}' not found. Using 'php'."
  wanted=$(pick /usr/bin/php /opt/homebrew/bin/php /usr/local/bin/php) || { echo "no php found" >&2; exit 1; }
}

ln -sf "${wanted}" "${HOME}/.bin/php"
inUse=$(php -nr "echo phpversion();")

echo "Shell configured to use PHP ${inUse}."
